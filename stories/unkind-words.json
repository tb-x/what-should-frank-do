{
  "id": "unkind-words",
  "title": "Words that hurt",
  "icon": "dino",
  "prompt": "a story about a friend saying 'You're not my friend'",
  "lesson": "If words hurt, say, 'I feel sad when you say that.'",
  "place": "classroom",
  "cast": ["frank", "ola", "maya", "msRosa"],
  "props": [
    { "id": "dino", "at": "rug.frontA" },
    { "id": "car", "at": "rug.frontB" }
  ],
  "scenes": {
    "start": [
      { "do": "place", "who": "frank", "at": "rug.a", "act": "sit", "feel": "happy", "hold": "dino" },
      { "do": "place", "who": "ola", "at": "rug.b", "act": "sit", "feel": "happy", "hold": "car" },
      { "do": "place", "who": "maya", "at": "easel" },
      { "do": "place", "who": "msRosa", "at": "table.2" },
      { "do": "cam", "shot": "wide", "cut": true },
      { "do": "say", "who": "narrator", "text": "This is Frank. He's playing dinosaurs with Ola." },
      { "do": "cam", "shot": "group", "on": ["frank", "ola"] },
      { "do": "face", "who": "frank", "feel": "joy" },
      { "do": "say", "who": "frank", "text": "Roar! The dino is hungry!" },
      { "do": "say", "who": "ola", "text": "Beep beep! Here comes the car!" },
      { "do": "say", "who": "ola", "text": "Frank, can I have the dino now?" },
      { "do": "face", "who": "frank", "feel": "neutral" },
      { "do": "say", "who": "frank", "text": "I'm still playing. You can have it after me." },
      { "do": "face", "who": "ola", "feel": "angry" },
      { "do": "act", "who": "ola", "anim": "angry", "with": "prev" },
      { "do": "say", "who": "ola", "text": "Then you're not my friend anymore!", "with": "prev" },
      { "do": "walk", "who": "ola", "to": "rug.c" },
      { "do": "say", "who": "narrator", "text": "Ola feels mad. She really wants the dino.", "with": "prev" },
      { "do": "cam", "shot": "close", "on": "frank" },
      { "do": "face", "who": "frank", "feel": "sad" },
      { "do": "say", "who": "narrator", "text": "Frank feels sad. Those words hurt." },
      { "do": "choice", "question": "What should Frank do?", "options": [
        { "id": "feel", "icon": "heart", "say": "Say how he feels", "kind": "good", "goto": "feel" },
        { "id": "sulk", "icon": "sulk", "say": "Go away sad", "kind": "feeling", "goto": "sulk" },
        { "id": "back", "icon": "shout", "say": "Say mean words back", "kind": "hurtful", "goto": "back" }
      ] }
    ],

    "sulk": [
      { "do": "cam", "shot": "wide" },
      { "do": "act", "who": "frank", "anim": "idle" },
      { "do": "walk", "who": "frank", "to": "reading" },
      { "do": "say", "who": "narrator", "text": "Frank goes to the book corner by himself.", "with": "prev" },
      { "do": "act", "who": "frank", "anim": "sit" },
      { "do": "say", "who": "narrator", "text": "It's OK to feel sad when words hurt." },
      { "do": "act", "who": "ola", "anim": "sit" },
      { "do": "face", "who": "ola", "feel": "sad", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Ola sits alone too.", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Ola doesn't know how Frank feels. Nobody is playing now." },
      { "do": "goto", "scene": "rewind" }
    ],

    "back": [
      { "do": "cam", "shot": "group", "on": ["frank", "ola"] },
      { "do": "face", "who": "frank", "feel": "angry" },
      { "do": "act", "who": "frank", "anim": "angry", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Frank shouts back at Ola. His words hurt too.", "with": "prev" },
      { "do": "face", "who": "ola", "feel": "cry" },
      { "do": "act", "who": "ola", "anim": "cry", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Now Ola feels hurt too.", "with": "prev" },
      { "do": "walk", "who": "msRosa", "to": { "near": "ola", "gap": 0.9 } },
      { "do": "cam", "shot": "group", "on": ["frank", "ola", "msRosa"], "with": "prev" },
      { "do": "face", "who": "msRosa", "feel": "worried" },
      { "do": "say", "who": "msRosa", "text": "Ola, Frank, please stop. I hear words that hurt." },
      { "do": "say", "who": "msRosa", "text": "Words like that hurt. Now you both feel sad." },
      { "do": "act", "who": "frank", "anim": "idle" },
      { "do": "say", "who": "narrator", "text": "The dinosaur game is over." },
      { "do": "goto", "scene": "rewind" }
    ],

    "rewind": [
      { "do": "fx", "type": "rewind" },
      { "do": "cam", "shot": "group", "on": ["frank", "ola"] },
      { "do": "say", "who": "narrator", "text": "Let's think. What else could Frank do?" },
      { "do": "goto", "scene": "feel" }
    ],

    "feel": [
      { "do": "cam", "shot": "group", "on": ["frank", "ola"] },
      { "do": "act", "who": "frank", "anim": "breathe" },
      { "do": "say", "who": "narrator", "text": "Frank takes a big breath.", "with": "prev" },
      { "do": "face", "who": "frank", "feel": "neutral" },
      { "do": "walk", "who": "frank", "to": { "near": "ola", "gap": 0.8 } },
      { "do": "look", "who": "ola", "at": "frank" },
      { "do": "say", "who": "frank", "text": "Ola, I feel sad when you say that." },
      { "do": "face", "who": "ola", "feel": "embarrassed" },
      { "do": "say", "who": "ola", "text": "Sorry, Frank. I said words that hurt. You are my friend." },
      { "do": "say", "who": "frank", "text": "The dino can ride in your car! Let's play together." },
      { "do": "face", "who": ["ola", "frank"], "feel": "happy" },
      { "do": "say", "who": "ola", "text": "Yes!" },
      { "do": "walk", "who": "msRosa", "to": { "near": "ola", "gap": 1.0 } },
      { "do": "cam", "shot": "group", "on": ["frank", "ola", "msRosa"], "with": "prev" },
      { "do": "say", "who": "msRosa", "text": "Ola, you felt mad because you wanted the dino." },
      { "do": "say", "who": "msRosa", "text": "Waiting is hard. Next time, say, 'I feel mad. I'll wait.'" },
      { "do": "say", "who": "msRosa", "text": "Frank, you said how you feel. Ola, you said sorry." },
      { "do": "say", "who": "msRosa", "text": "Friends can feel mad and still be friends." },
      { "do": "say", "who": "msRosa", "text": "If words that hurt don't stop, come and tell me." },
      { "do": "goto", "scene": "end" }
    ],

    "end": [
      { "do": "say", "who": "narrator", "text": "Frank finishes his turn." },
      { "do": "give", "who": "frank", "item": "dino", "to": "ola" },
      { "do": "say", "who": "frank", "text": "Your turn with the dino!" },
      { "do": "cam", "shot": "group", "on": ["frank", "ola"] },
      { "do": "face", "who": ["frank", "ola"], "feel": "joy" },
      { "do": "fx", "type": "stars", "on": ["frank", "ola"], "with": "prev" },
      { "do": "say", "who": "narrator", "text": "If words hurt, say, 'I feel sad when you say that.'" },
      { "do": "end" }
    ]
  }
}
