{
  "id": "tidy-up",
  "title": "Tidy-up time",
  "icon": "tidy",
  "prompt": "a story about not wanting to stop playing at tidy-up time",
  "lesson": "Hard to stop? Take a big breath, ask, then help tidy.",
  "place": "classroom",
  "cast": ["frank", "sam", "maya", "msRosa"],
  "props": [
    { "id": "blocks", "at": "rug.middle", "knocked": true },
    { "id": "car", "at": "rug.frontA" },
    { "id": "block", "at": "rug.frontB" },
    { "id": "crayons", "at": "table.1.place1" }
  ],
  "scenes": {
    "start": [
      { "do": "place", "who": "frank", "at": "rug.a", "act": "sit", "feel": "joy" },
      { "do": "place", "who": "sam", "at": "rug.b", "act": "sit", "feel": "happy" },
      { "do": "place", "who": "maya", "at": "table.1.seat1", "act": "sitChair" },
      { "do": "place", "who": "msRosa", "at": "easel" },
      { "do": "cam", "shot": "wide", "cut": true },
      { "do": "say", "who": "narrator", "text": "This is Frank. He's building with Sam." },
      { "do": "cam", "shot": "group", "on": ["frank", "sam"] },
      { "do": "rebuild", "who": ["frank", "sam"], "item": "blocks" },
      { "do": "say", "who": "narrator", "text": "The tower gets taller and taller.", "with": "prev" },
      { "do": "say", "who": "sam", "text": "It's the biggest tower ever!" },
      { "do": "say", "who": "frank", "text": "Let's make it reach the sky!" },
      { "do": "cam", "shot": "wide" },
      { "do": "act", "who": "msRosa", "anim": "clap" },
      { "do": "say", "who": "msRosa", "text": "Tidy-up time, everyone! Then it's story time.", "with": "prev" },
      { "do": "act", "who": "msRosa", "anim": "idle" },
      { "do": "act", "who": "maya", "anim": "idle" },
      { "do": "take", "who": "maya", "item": "crayons" },
      { "do": "walk", "who": "maya", "to": "shelf" },
      { "do": "say", "who": "narrator", "text": "Maya starts tidying.", "with": "prev" },
      { "do": "drop", "who": "maya", "item": "crayons", "at": "shelf.top" },
      { "do": "walk", "who": "maya", "to": "reading" },
      { "do": "cam", "shot": "close", "on": "frank" },
      { "do": "face", "who": "frank", "feel": "angry" },
      { "do": "say", "who": "frank", "text": "No! We're not finished!" },
      { "do": "say", "who": "narrator", "text": "Frank feels cross. It's hard to stop when you're having fun." },
      { "do": "choice", "question": "What should Frank do?", "options": [
        { "id": "keep", "icon": "play", "say": "Keep playing", "kind": "feeling", "goto": "keep" },
        { "id": "knock", "icon": "blocks", "say": "Knock the tower down", "kind": "hurtful", "goto": "knock" },
        { "id": "ask", "icon": "breathe", "say": "Breathe, then ask", "kind": "good", "goto": "ask" }
      ] }
    ],

    "keep": [
      { "do": "cam", "shot": "wide" },
      { "do": "act", "who": "frank", "anim": "play" },
      { "do": "say", "who": "narrator", "text": "Frank keeps playing. He pretends not to hear.", "with": "prev" },
      { "do": "walk", "who": "msRosa", "to": "reading" },
      { "do": "act", "who": "sam", "anim": "idle", "with": "prev" },
      { "do": "walk", "who": "sam", "to": { "near": "msRosa", "gap": 1.0 } },
      { "do": "walk", "who": "maya", "to": { "near": "msRosa", "gap": 1.1 }, "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Everyone else tidies up and sits down.", "with": "prev" },
      { "do": "act", "who": ["sam", "maya"], "anim": "sit" },
      { "do": "say", "who": "msRosa", "text": "Story time! Once upon a time..." },
      { "do": "face", "who": "frank", "feel": "sad" },
      { "do": "say", "who": "narrator", "text": "The story starts without Frank. Now he feels left out." },
      { "do": "say", "who": "msRosa", "text": "Frank, come and join us. It's story time." },
      { "do": "goto", "scene": "rewind" }
    ],

    "knock": [
      { "do": "cam", "shot": "group", "on": ["frank", "sam"] },
      { "do": "act", "who": "frank", "anim": "angry" },
      { "do": "knock", "item": "blocks", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Crash! Frank knocks the tower down." },
      { "do": "face", "who": "sam", "feel": "sad" },
      { "do": "say", "who": "sam", "text": "Hey! I built it too!" },
      { "do": "act", "who": "frank", "anim": "idle" },
      { "do": "walk", "who": "msRosa", "to": { "near": "frank", "gap": 0.9 } },
      { "do": "cam", "shot": "group", "on": ["frank", "sam", "msRosa"], "with": "prev" },
      { "do": "face", "who": "msRosa", "feel": "worried" },
      { "do": "say", "who": "msRosa", "text": "Frank, stop please. You're cross, but Sam didn't want it knocked down." },
      { "do": "say", "who": "msRosa", "text": "Sam feels sad. He built it too." },
      { "do": "say", "who": "narrator", "text": "Now there's more to tidy, and story time starts late." },
      { "do": "goto", "scene": "rewind" }
    ],

    "rewind": [
      { "do": "fx", "type": "rewind" },
      { "do": "cam", "shot": "group", "on": ["frank", "sam"] },
      { "do": "say", "who": "narrator", "text": "Let's think. What else could Frank do?" },
      { "do": "goto", "scene": "ask" }
    ],

    "ask": [
      { "do": "cam", "shot": "group", "on": ["frank", "sam"] },
      { "do": "act", "who": "frank", "anim": "breathe" },
      { "do": "say", "who": "narrator", "text": "Frank takes a big breath.", "with": "prev" },
      { "do": "face", "who": "frank", "feel": "neutral" },
      { "do": "act", "who": "frank", "anim": "idle" },
      { "do": "walk", "who": "frank", "to": { "near": "msRosa", "gap": 0.9 } },
      { "do": "cam", "shot": "group", "on": ["frank", "msRosa"], "with": "prev" },
      { "do": "say", "who": "frank", "text": "Ms Rosa, I don't want to stop. Can we finish later?" },
      { "do": "face", "who": "msRosa", "feel": "happy" },
      { "do": "say", "who": "msRosa", "text": "You feel cross. It's hard to stop when it's fun." },
      { "do": "say", "who": "msRosa", "text": "Sometimes we can't. Today, yes. The tower can stay." },
      { "do": "say", "who": "msRosa", "text": "Now let's tidy the rest, please." },
      { "do": "take", "who": "frank", "item": "car" },
      { "do": "walk", "who": "frank", "to": "shelf" },
      { "do": "say", "who": "narrator", "text": "Frank tidies the car.", "with": "prev" },
      { "do": "drop", "who": "frank", "item": "car", "at": "shelf.top" },
      { "do": "take", "who": "sam", "item": "block" },
      { "do": "walk", "who": "sam", "to": { "near": "frank", "gap": 0.7 } },
      { "do": "say", "who": "narrator", "text": "Sam tidies the letter block.", "with": "prev" },
      { "do": "drop", "who": "sam", "item": "block", "at": "shelf.top" },
      { "do": "cam", "shot": "group", "on": ["frank", "sam", "msRosa"] },
      { "do": "say", "who": "msRosa", "text": "Frank, you took a big breath, asked, and helped tidy." },
      { "do": "say", "who": "msRosa", "text": "Sam, you helped tidy up." },
      { "do": "goto", "scene": "end" }
    ],

    "end": [
      { "do": "walk", "who": "msRosa", "to": "reading" },
      { "do": "walk", "who": "frank", "to": { "near": "msRosa", "gap": 1.0 } },
      { "do": "walk", "who": "sam", "to": { "near": "msRosa", "gap": 1.2 }, "with": "prev" },
      { "do": "cam", "shot": "group", "on": ["frank", "sam", "msRosa"] },
      { "do": "face", "who": ["frank", "sam"], "feel": "joy" },
      { "do": "act", "who": ["frank", "sam"], "anim": "sit", "with": "prev" },
      { "do": "fx", "type": "stars", "on": ["frank", "sam"], "with": "prev" },
      { "do": "say", "who": "sam", "text": "Story time!", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Hard to stop? Take a big breath, ask, then help tidy." },
      { "do": "end" }
    ]
  }
}
