      { "do": "face", "who": "msRosa", "feel": "happy" },
      { "do": "say", "who": "msRosa", "text": "Zoe, you love hugs. You felt sad when Frank said no." },
      { "do": "say", "who": "msRosa", "text": "Frank didn't want a hug. He still likes you!" },
      { "do": "say", "who": "msRosa", "text": "Your body is yours. Frank's body is his." },
      { "do": "say", "who": "msRosa", "text": "Ask before a hug. 'No thank you' means stop." },
      { "do": "say", "who": "msRosa", "text": "Frank, you said no with kind words. Zoe, you stopped right away." },
      { "do": "look", "who": "zoe", "at": "ola" },
      { "do": "say", "who": "zoe", "text": "Ola, can I have a hug?" },
      { "do": "act", "who": "ola", "anim": "idle" },
