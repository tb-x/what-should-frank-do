      { "do": "choice", "question": "What should Frank do?", "options": [
        { "id": "try", "icon": "breathe", "say": "Breathe and try again", "kind": "good", "goto": "try" },
        { "id": "give", "icon": "sulk", "say": "Give up and walk away", "kind": "feeling", "goto": "give" },
        { "id": "shout", "icon": "shout", "say": "Shout at Leo", "kind": "hurtful", "goto": "shout" }
      ] }
    ],

    "give": [
      { "do": "cam", "shot": "wide" },
      { "do": "act", "who": "frank", "anim": "idle" },
      { "do": "walk", "who": "frank", "to": { "near": "mrBen", "gap": 1.0 } },
      { "do": "say", "who": "narrator", "text": "Frank gives up and walks away.", "with": "prev" },
      { "do": "act", "who": "frank", "anim": "sit" },
      { "do": "face", "who": "frank", "feel": "sad", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "It's OK to feel mad when things are hard." },
      { "do": "say", "who": "narrator", "text": "But the castle is still broken, and Frank feels worse." },
      { "do": "goto", "scene": "rewind" }
    ],

    "shout": [
      { "do": "cam", "shot": "group", "on": ["frank", "leo"] },
      { "do": "act", "who": "frank", "anim": "angry" },
      { "do": "say", "who": "narrator", "text": "Frank shouts at Leo to go away.", "with": "prev" },
      { "do": "face", "who": "leo", "feel": "sad" },
      { "do": "say", "who": "leo", "text": "I only wanted to help." },
      { "do": "walk", "who": "leo", "to": "sandbox.b" },
      { "do": "act", "who": "frank", "anim": "idle", "with": "prev" },
      { "do": "act", "who": "mrBen", "anim": "idle" },
      { "do": "walk", "who": "mrBen", "to": { "near": "frank", "gap": 0.9 } },
      { "do": "cam", "shot": "group", "on": ["frank", "leo", "mrBen"], "with": "prev" },
      { "do": "face", "who": "mrBen", "feel": "worried" },
      { "do": "say", "who": "mrBen", "text": "Frank, please stop. You feel mad. Shouting at Leo isn't kind." },
      { "do": "say", "who": "mrBen", "text": "You can say, 'No thanks, I want to try first.'" },
      { "do": "say", "who": "narrator", "text": "Now Leo feels sad, and the castle is still broken." },
      { "do": "goto", "scene": "rewind" }
    ],

    "rewind": [
      { "do": "fx", "type": "rewind" },
      { "do": "cam", "shot": "group", "on": ["frank", "leo"] },
      { "do": "say", "who": "narrator", "text": "Let's think. What else could Frank do?" },
      { "do": "goto", "scene": "try" }
    ],

    "try": [
      { "do": "cam", "shot": "group", "on": ["frank", "leo"] },
      { "do": "act", "who": "frank", "anim": "breathe" },
      { "do": "say", "who": "narrator", "text": "Frank takes a big breath.", "with": "prev" },
      { "do": "face", "who": "frank", "feel": "neutral" },
      { "do": "say", "who": "frank", "text": "Thanks, Leo. I want to try one more time." },
      { "do": "rebuild", "who": ["frank"], "item": "castle" },
      { "do": "knock", "item": "castle" },
      { "do": "say", "who": "narrator", "text": "Plop! It's still tricky. Frank stays calm.", "with": "prev" },
      { "do": "say", "who": "frank", "text": "Leo, can you show me?" },
      { "do": "face", "who": "leo", "feel": "happy" },
      { "do": "say", "who": "leo", "text": "Yes! Wet sand sticks. Pat it down hard, like this." },
      { "do": "rebuild", "who": ["frank", "leo"], "item": "castle" },
      { "do": "say", "who": "narrator", "text": "Pat, pat, pat. The castle stays up!", "with": "prev" },
      { "do": "fx", "type": "sparkle", "on": ["castle"] },
      { "do": "face", "who": "frank", "feel": "joy", "with": "prev" },
      { "do": "say", "who": "frank", "text": "We did it!", "with": "prev" },
      { "do": "act", "who": "mrBen", "anim": "idle" },
      { "do": "walk", "who": "mrBen", "to": { "near": "frank", "gap": 1.0 } },
      { "do": "cam", "shot": "group", "on": ["frank", "leo", "mrBen"], "with": "prev" },
      { "do": "face", "who": "mrBen", "feel": "happy" },
      { "do": "say", "who": "mrBen", "text": "Frank, that was tricky, and you felt mad." },
      { "do": "say", "who": "mrBen", "text": "You took a big breath, tried again, and asked." },
      { "do": "say", "who": "mrBen", "text": "Leo, you showed Frank how. That was kind." },
      { "do": "goto", "scene": "end" }
    ],

    "end": [
      { "do": "cam", "shot": "group", "on": ["frank", "leo"] },
      { "do": "face", "who": ["frank", "leo"], "feel": "joy" },
      { "do": "fx", "type": "stars", "on": ["frank", "leo"], "with": "prev" },
      { "do": "say", "who": "leo", "text": "Let's build a whole town!", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Tricky? Take a big breath, try again, ask, 'Can you show me?'" },
      { "do": "end" }
    ]
  }
}
