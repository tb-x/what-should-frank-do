{
  "id": "tricky-castle",
  "title": "The tricky castle",
  "icon": "castle",
  "prompt": "a story about getting frustrated when something is hard",
  "lesson": "Tricky? Take a big breath, try again, ask, 'Can you show me?'",
  "place": "playground",
  "cast": ["frank", "leo", "sam", "mrBen"],
  "props": [
    { "id": "castle", "at": "sandbox.castle", "knocked": true }
