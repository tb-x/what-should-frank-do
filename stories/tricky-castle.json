      { "do": "cam", "shot": "group", "on": ["frank", "leo"] },
      { "do": "rebuild", "who": ["frank"], "item": "castle" },
      { "do": "say", "who": "narrator", "text": "Pat, pat, pat. It gets taller.", "with": "prev" },
      { "do": "face", "who": "frank", "feel": "joy" },
      { "do": "say", "who": "frank", "text": "Look, Leo! A big castle!" },
      { "do": "knock", "item": "castle" },
      { "do": "face", "who": "frank", "feel": "surprised", "with": "prev" },
      { "do": "say", "who": "narrator", "text": "Plop! The castle falls down." },
      { "do": "face", "who": "frank", "feel": "worried" },
      { "do": "say", "who": "frank", "text": "Oh no. I'll try again." },
      { "do": "rebuild", "who": ["frank"], "item": "castle" },
      { "do": "knock", "item": "castle" },
      { "do": "say", "who": "narrator", "text": "Plop! It falls down again.", "with": "prev" },
      { "do": "face", "who": "frank", "feel": "angry" },
      { "do": "act", "who": "frank", "anim": "angry", "with": "prev" },
      { "do": "say", "who": "frank", "text": "It's too hard! I can't do it!", "with": "prev" },
      { "do": "act", "who": "leo", "anim": "idle" },
      { "do": "walk", "who": "leo", "to": { "near": "frank", "gap": 0.9 } },
      { "do": "say", "who": "leo", "text": "Frank, do you want some help?" },
      { "do": "cam", "shot": "close", "on": "frank" },
