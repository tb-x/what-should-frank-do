  "scenes": {
    "start": [
      { "do": "place", "who": "frank", "at": "sandbox.a", "act": "play", "feel": "happy" },
      { "do": "place", "who": "leo", "at": "sandbox.b", "act": "play" },
      { "do": "place", "who": "sam", "at": "swing.1" },
      { "do": "place", "who": "mrBen", "at": "bench", "act": "sitChair" },
      { "do": "cam", "shot": "wide", "cut": true },
